# Server
PORT=4000

# Admin credentials (login used by the admin "Prijava" button)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=andrijanadarko357

# Secret used to sign admin session tokens - generate your own long random string, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-your-own-generated-secret

# Comma separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Cloudinary account that stores the uploaded photos (dashboard.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder inside Cloudinary where photos are kept (lets you reuse one account for prod + test)
CLOUDINARY_FOLDER=wedding-gallery-test
